{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Design tokens for TideNative (OLED Spatial Immersion, Tauri v2 + React 19).",
  "color": {
    "canvas": {
      "$value": "#040406",
      "$type": "color"
    },
    "ambient-top": {
      "$value": "#0A0B0F",
      "$type": "color"
    },
    "elevated": {
      "$value": "#111116",
      "$type": "color"
    },
    "elevated-hover": {
      "$value": "#17171F",
      "$type": "color"
    },
    "surface-tint": {
      "$value": "#0B0D14",
      "$type": "color"
    },
    "glass-surface": {
      "$value": "rgba(18, 18, 24, 0.84)",
      "$type": "color"
    },
    "glass-pill": {
      "$value": "rgba(24, 24, 30, 0.88)",
      "$type": "color"
    },
    "hairline": {
      "$value": "rgba(255, 255, 255, 0.08)",
      "$type": "color"
    },
    "specular": {
      "$value": "rgba(255, 255, 255, 0.13)",
      "$type": "color"
    },
    "strong-border": {
      "$value": "rgba(255, 255, 255, 0.22)",
      "$type": "color"
    },
    "ink-primary": {
      "$value": "#F5F5F7",
      "$type": "color"
    },
    "ink-secondary": {
      "$value": "rgba(235, 235, 245, 0.70)",
      "$type": "color"
    },
    "ink-muted": {
      "$value": "rgba(235, 235, 245, 0.58)",
      "$type": "color"
    },
    "tidal-max": {
      "$value": "#FFD432",
      "$type": "color"
    },
    "tidal-high": {
      "$value": "#33F3FF",
      "$type": "color"
    },
    "tidal-low": {
      "$value": "#A8A8B3",
      "$type": "color"
    },
    "bit-perfect": {
      "$value": "#30D158",
      "$type": "color"
    },
    "favorite": {
      "$value": "#FF2D55",
      "$type": "color"
    },
    "signal-danger": {
      "$value": "#FF453A",
      "$type": "color"
    }
  },
  "font": {
    "sans": {
      "$value": "\"Inter\", \"Segoe UI Variable\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
      "$type": "fontFamily"
    },
    "display": {
      "$value": "\"Season Mix\", \"season-mix\", \"Inter\", system-ui, sans-serif",
      "$type": "fontFamily"
    },
    "mono": {
      "$value": "\"JetBrains Mono\", \"Cascadia Code\", ui-monospace, monospace",
      "$type": "fontFamily"
    }
  },
  "spacing": {
    "xs": {
      "$value": "4px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "md": {
      "$value": "16px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "24px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "32px",
      "$type": "dimension"
    }
  },
  "radius": {
    "md": {
      "$value": "12px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension"
    },
    "pill": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "semantic": {
    "color": {
      "background": {
        "$value": "{color.canvas}",
        "$type": "color"
      },
      "foreground": {
        "$value": "{color.ink-primary}",
        "$type": "color"
      },
      "card": {
        "$value": "{color.elevated}",
        "$type": "color"
      },
      "accent": {
        "$value": "{color.tidal-high}",
        "$type": "color"
      },
      "focus-ring": {
        "$value": "{color.tidal-high}",
        "$type": "color"
      },
      "destructive": {
        "$value": "{color.signal-danger}",
        "$type": "color"
      }
    }
  }
}
