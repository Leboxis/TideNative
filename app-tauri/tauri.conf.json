{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TideNative",
  "version": "0.1.0",
  "identifier": "com.tidenative.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TideNative",
        "width": 1380,
        "height": 860,
        "minWidth": 1020,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#040406",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../installer/TideNative.ico"
    ]
  }
}
